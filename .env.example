# Local development environment for pp-project
# Copy to .env and adjust. .env is gitignored.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Production (DJANGO_DEBUG=False, which is also the default when unset):
# DJANGO_SECRET_KEY must be 50+ random characters or the app refuses to start.
# HTTPS redirect, secure cookies and HSTS switch on automatically; TLS is
# expected to terminate at nginx, which must set X-Forwarded-Proto.
# CSRF_TRUSTED_ORIGINS=https://pp.swlt.ae
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600

# Database — SQLite by default for local dev.
# For PostgreSQL, uncomment and fill in:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=pp_portal
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Email — console backend prints emails to the terminal instead of sending.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# LiveKit video conferencing (optional — conference features are inert without it)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://livekit.swlt.ae
LIVEKIT_HTTP_URL=http://127.0.0.1:7880

# Local path for conference recordings
RECORDING_ROOT=./media/recordings

# OpenAI API key (optional — used for live caption translation)
OPENAI_API_KEY=

# GTK/Pango DLL directory for WeasyPrint PDF export (Windows).
# Installed via MSYS2: pacman -S mingw-w64-x86_64-pango
GTK_BIN_DIR=C:\msys64\mingw64\bin
